---
import Breadcrumbs from './Breadcrumbs.astro';
export interface Props {
  title: string;
  subtitle?: string;
  crumbs?: { name: string; href: string }[];
  eyebrow?: string;
}
const { title, subtitle, crumbs, eyebrow } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line bg-brand-950 text-white">
  <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true" data-parallax="0.06"
       style="background:radial-gradient(60rem 30rem at 80% -20%, rgba(79,116,189,.55), transparent 60%), radial-gradient(40rem 24rem at 0% 120%, rgba(200,16,46,.35), transparent 55%);"></div>
  <div class="container-page relative pb-14 pt-24 md:pb-20 md:pt-32">
    {crumbs && <Breadcrumbs items={crumbs} />}
    {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-accent-300">{eyebrow}</p>}
    <h1 class="font-display text-3xl font-semibold leading-tight md:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-brand-100 md:text-lg">{subtitle}</p>}
  </div>
</section>
