---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Lightbox from '../../components/Lightbox.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { galleryImage } from '../../lib/images';

export async function getStaticPaths() {
  const galleries = await getCollection('galleries');
  return galleries.map((g) => ({ params: { slug: g.data.slug }, props: { gallery: g } }));
}

const { gallery } = Astro.props;
const g = gallery.data;
const crumbs = [
  { name: 'Gallery', href: '/gallery' },
  { name: g.title, href: `/gallery/${g.slug}` },
];
const images = g.images
  .map((im) => ({ ...im, src: galleryImage(g.dir, im.file) }))
  .filter((im) => im.src);
---

<BaseLayout title={g.title} description={g.subtitle} path={`/gallery/${g.slug}`}
  jsonLd={[breadcrumbJsonLd(crumbs)]}>
  <PageHero eyebrow="Gallery" title={g.title} crumbs={crumbs} subtitle={g.subtitle} />

  <section class="container-page py-16">
    <div class="columns-2 gap-4 md:columns-3 lg:columns-4 [&>*]:mb-4">
      {images.map((im, i) => (
        <button type="button" class="js-lightbox group block w-full overflow-hidden rounded-xl border border-line bg-brand-50"
          data-index={i} data-caption={im.caption}>
          <Image src={im.src!} alt={im.caption} width={600} height={450}
            class="h-auto w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading={i < 8 ? 'eager' : 'lazy'} />
          <span class="sr-only">{im.caption}</span>
        </button>
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">{images.length} photographs · Click any image to view larger.</p>
  </section>

  <Lightbox images={images.map((im) => ({ src: im.src!.src, caption: im.caption, w: im.src!.width, h: im.src!.height }))} />
</BaseLayout>
