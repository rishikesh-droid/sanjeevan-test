---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" noindex path="/404">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-7xl font-semibold text-brand-200">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-brand-900">Page not found</h1>
    <p class="mt-3 max-w-md text-muted">The page you're looking for may have moved. Try one of these instead:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-brand-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-900">Home</a>
      <a href="/admissions" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-brand-800 hover:bg-surface-2">Admissions</a>
      <a href="/teaching-staff" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-brand-800 hover:bg-surface-2">Teaching Staff</a>
      <a href="/contact" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-brand-800 hover:bg-surface-2">Contact</a>
    </div>
  </section>
</BaseLayout>
