---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const about = await getEntry('pages', 'about');
const { Content } = about ? await render(about) : { Content: null };
const recognitions = (await getCollection('recognitions')).sort((a, b) => a.data.order - b.data.order);
const mandate = (await getCollection('documents'))
  .filter((d) => d.data.group === 'MUHS Mandate')
  .sort((a, b) => a.data.order - b.data.order);
const notices = (await getCollection('notices'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);
const dateFmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const faculty = (await getCollection('faculty'))
  .filter((f) => f.data.group === 'ent')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
const crumbs = [{ name: 'About', href: '/about' }];
---

<BaseLayout title="About the Institute" description={about?.data.description} path="/about"
  jsonLd={[breadcrumbJsonLd(crumbs)]}>
  <PageHero eyebrow="About" title="About the Institute" crumbs={crumbs}
    subtitle="A postgraduate ENT institute at Miraj, Maharashtra, recognised since 1984." />

  <!-- History -->
  <section id="history" class="container-page grid gap-12 py-16 lg:grid-cols-[1.5fr_1fr] lg:py-20">
    <article class="prose-block max-w-none">
      {Content && <Content />}
    </article>
    <aside class="self-start rounded-2xl border border-line bg-surface-2 p-7">
      <h2 class="font-display text-lg font-semibold text-brand-900">At a glance</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-muted">Established</dt><dd class="font-semibold text-brand-800">1984</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted">Specialisation</dt><dd class="font-semibold text-brand-800">ENT</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted">MS (ENT) seats</dt><dd class="font-semibold text-brand-800">3 / year</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted">University</dt><dd class="font-semibold text-brand-800">MUHS, Nashik</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted">Location</dt><dd class="font-semibold text-brand-800">Miraj, MH</dd></div>
      </dl>
    </aside>
  </section>

  <!-- Recognitions -->
  <section id="recognitions" class="scroll-mt-24 bg-surface-2 py-16 lg:py-20">
    <div class="container-page">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-600">Recognitions & Affiliations</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-brand-900">Recognised and affiliated by national and state authorities</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {recognitions.map((r) => (
          <div data-reveal class="flex flex-col rounded-2xl border border-line bg-surface p-6 shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-1 hover:border-brand-300">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-display text-lg font-semibold text-brand-900">{r.data.name}</h3>
              {r.data.year && <span class="whitespace-nowrap rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">{r.data.year}</span>}
            </div>
            {r.data.abbr && <p class="mt-0.5 text-sm font-semibold text-accent-600">{r.data.abbr}</p>}
            <p class="mt-2 flex-1 text-sm text-muted">{r.data.role}</p>
            {r.data.pdf && <a href={r.data.pdf} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-accent-600" target="_blank" rel="noopener">View document (PDF) →</a>}
          </div>
        ))}
      </div>

      {mandate.length > 0 && (
        <div class="mt-12">
          <h3 class="font-display text-xl font-semibold text-brand-900">MUHS Mandate — LIC (Local Inquiry Committee) Reports</h3>
          <p class="mt-1 text-sm text-muted">Annual MUHS Local Inquiry Committee Part-II reports.</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {mandate.map((d) => (
              <a href={d.data.pdf} target="_blank" rel="noopener"
                class="flex items-center gap-3 rounded-xl border border-line bg-surface p-4 shadow-[var(--shadow-card)] transition hover:border-brand-300">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-700">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.6"/><path d="M14 3v5h5" stroke="currentColor" stroke-width="1.6"/></svg>
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-sm font-semibold text-brand-800">MUHS LIC Part II</span>
                  <span class="block text-xs text-muted">A.Y. {d.data.year} · PDF</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Notices & Circulars -->
  <section id="notices" class="scroll-mt-24 container-page py-16 lg:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-600">Notices & Circulars</p>
    <h2 class="mt-3 font-display text-3xl font-semibold text-brand-900">Official notices & documents</h2>
    <p class="mt-2 max-w-3xl text-sm text-muted">Admission circulars, affiliation documents and official letters.</p>
    <ul class="mt-8 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface shadow-[var(--shadow-card)]">
      {notices.map((n) => (
        <li data-reveal class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-4 transition-colors hover:bg-surface-2">
          <span class="whitespace-nowrap rounded-md bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">{n.data.category}</span>
          <a href={`/notices/${n.id}`} class="flex-1 text-sm font-semibold text-brand-800 hover:text-accent-600">{n.data.title}</a>
          <span class="text-xs text-muted">{dateFmt(n.data.date)}</span>
          {n.data.pdf && <a href={n.data.pdf} target="_blank" rel="noopener" class="whitespace-nowrap text-xs font-semibold text-brand-700 hover:text-accent-600">PDF →</a>}
        </li>
      ))}
    </ul>
  </section>

  <!-- Leadership -->
  <section id="leadership" class="scroll-mt-24 container-page py-16 lg:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-600">Leadership</p>
    <h2 class="mt-3 font-display text-3xl font-semibold text-brand-900">Institute leadership</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {faculty.map((f) => (
        <div data-reveal class="rounded-2xl border border-line bg-surface p-6 shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-1 hover:border-brand-300">
          <h3 class="font-display text-lg font-semibold text-brand-900">{f.data.name}</h3>
          <p class="mt-1 text-sm font-medium text-accent-600">{f.data.designation}</p>
          <p class="mt-2 text-sm text-muted">{f.data.qualifications}</p>
        </div>
      ))}
    </div>
    <a href="/teaching-staff" class="mt-8 inline-block text-sm font-semibold text-brand-700 hover:text-accent-600">Meet the full teaching staff →</a>
  </section>
</BaseLayout>
