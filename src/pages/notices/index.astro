---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { breadcrumbJsonLd } from '../../lib/seo';

const notices = (await getCollection('notices'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => (a.data.pinned === b.data.pinned ? +b.data.date - +a.data.date : a.data.pinned ? -1 : 1));
const crumbs = [{ name: 'Notices', href: '/notices' }];
const dateFmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Notices & Circulars" path="/notices"
  description="Official notices, admission circulars, results and affiliation documents from Sanjeevan PGI, Miraj."
  jsonLd={[breadcrumbJsonLd(crumbs)]}>
  <PageHero eyebrow="Notices" title="Notices & Circulars" crumbs={crumbs}
    subtitle="Admission dates, results, affiliation documents and official announcements." />

  <section class="container-page py-16">
    <ul class="space-y-4">
      {notices.map((n) => (
        <li>
          <a href={`/notices/${n.id}`} class="flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-brand-300 sm:flex-row sm:items-center">
            <div class="flex items-center gap-3">
              {n.data.pinned && <span class="rounded-full bg-accent-50 px-2.5 py-1 text-xs font-semibold text-accent-700">Pinned</span>}
              <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">{n.data.category}</span>
            </div>
            <div class="flex-1">
              <h2 class="font-display text-lg font-semibold text-brand-900">{n.data.title}</h2>
              {n.data.summary && <p class="mt-1 text-sm text-muted">{n.data.summary}</p>}
            </div>
            <div class="flex items-center gap-4">
              <time class="whitespace-nowrap text-sm text-muted">{dateFmt(n.data.date)}</time>
              <span class="text-accent-600" aria-hidden="true">→</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
