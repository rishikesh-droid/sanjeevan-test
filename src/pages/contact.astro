---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';

const c = site.contact;
const f = site.fellowshipContact;
const crumbs = [{ name: 'Contact', href: '/contact' }];
---

<BaseLayout title="Contact" path="/contact"
  description="Contact Sanjeevan PGI, Miraj — address, phone and email for the ENT Post Graduate Institute and the Fellowship Cancer Hospital."
  jsonLd={[breadcrumbJsonLd(crumbs)]}>
  <PageHero eyebrow="Contact" title="Contact Us" crumbs={crumbs}
    subtitle="Reach the institute office for admissions and general enquiries." />

  <section class="container-page grid gap-8 py-16 lg:grid-cols-2">
    <!-- ENT institute -->
    <div data-reveal class="rounded-2xl border border-line bg-surface p-7 shadow-[var(--shadow-card)]">
      <h2 class="font-display text-xl font-semibold text-brand-900">ENT Post Graduate Institute</h2>
      <address class="mt-4 space-y-1 text-sm not-italic text-muted">
        {c.addressLines.map((l) => <p>{l}</p>)}
      </address>
      <dl class="mt-5 space-y-2 text-sm">
        <div class="flex gap-2"><dt class="w-16 shrink-0 font-semibold text-brand-800">Phone</dt><dd>{c.phones.map((p, i) => (<><a href={`tel:${p.replace(/[^0-9+]/g,'')}`} class="text-brand-700 hover:text-accent-600">{p}</a>{i < c.phones.length - 1 ? ', ' : ''}</>))}</dd></div>
        <div class="flex gap-2"><dt class="w-16 shrink-0 font-semibold text-brand-800">Email</dt><dd><a href={`mailto:${c.email}`} class="text-brand-700 hover:text-accent-600">{c.email}</a></dd></div>
      </dl>
      <div class="mt-5 border-t border-line pt-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-400">Admission Coordinators</p>
        <ul class="mt-2 space-y-1 text-sm text-muted">
          {c.coordinators.map((p) => (
            <li><span class="font-medium text-brand-800">{p.name}</span> — <a href={`tel:${p.cell.replace(/[^0-9+]/g,'')}`} class="text-brand-700 hover:text-accent-600">{p.cell}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Fellowship — Cancer Hospital -->
    <div data-reveal class="rounded-2xl border border-line bg-surface-2 p-7">
      <h2 class="font-display text-xl font-semibold text-brand-900">Fellowship — Cancer Hospital</h2>
      <p class="mt-1 text-sm text-muted">{f.name}</p>
      <address class="mt-3 space-y-1 text-sm not-italic text-muted">
        {f.addressLines.map((l) => <p>{l}</p>)}
      </address>
      <dl class="mt-4 space-y-2 text-sm">
        <div class="flex gap-2"><dt class="w-16 shrink-0 font-semibold text-brand-800">Phone</dt><dd><a href={`tel:${f.phones[0].replace(/[^0-9+]/g,'')}`} class="text-brand-700 hover:text-accent-600">{f.phones[0]}</a></dd></div>
        {f.fax && <div class="flex gap-2"><dt class="w-16 shrink-0 font-semibold text-brand-800">Fax</dt><dd class="text-muted">{f.fax}</dd></div>}
        <div class="flex gap-2"><dt class="w-16 shrink-0 font-semibold text-brand-800">Email</dt><dd><a href={`mailto:${f.email}`} class="text-brand-700 hover:text-accent-600">{f.email}</a></dd></div>
      </dl>
      <div class="mt-5 border-t border-line pt-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-400">Fellowship Coordinator</p>
        <ul class="mt-2 space-y-1 text-sm text-muted">
          {f.coordinators.map((p) => (
            <li><span class="font-medium text-brand-800">{p.name}</span> — <a href={`tel:${p.cell.replace(/[^0-9+]/g,'')}`} class="text-brand-700 hover:text-accent-600">{p.cell}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Enquiry / Contact Form (Dummy / Demo) -->
    <div data-reveal class="rounded-2xl border border-line bg-surface p-7 shadow-[var(--shadow-card)] lg:col-span-2">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Send a Message</p>
        <h2 class="mt-1 font-display text-2xl font-semibold text-brand-900">Admission &amp; General Enquiry</h2>
        <p class="mt-1 text-sm text-muted">
          Have a question about MS (ENT) or Fellowship admissions? Fill out the form below and our office will get back to you.
        </p>
      </div>

      <form id="contact-form" class="mt-6 grid gap-5 sm:grid-cols-2" novalidate>
        <!-- Honeypot field for basic bot filtering -->
        <div class="hidden" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <label for="cf-name" class="block text-sm font-medium text-brand-800">
            Full Name <span class="text-accent-600">*</span>
          </label>
          <input
            id="cf-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Dr. / Mr. / Ms. Full Name"
            class="mt-1.5 w-full rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-brand-500 focus:bg-surface focus:outline-none"
          />
        </div>

        <div>
          <label for="cf-email" class="block text-sm font-medium text-brand-800">
            Email Address <span class="text-accent-600">*</span>
          </label>
          <input
            id="cf-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="mt-1.5 w-full rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-brand-500 focus:bg-surface focus:outline-none"
          />
        </div>

        <div>
          <label for="cf-phone" class="block text-sm font-medium text-brand-800">
            Phone Number
          </label>
          <input
            id="cf-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="+91 98765 43210"
            class="mt-1.5 w-full rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-brand-500 focus:bg-surface focus:outline-none"
          />
        </div>

        <div>
          <label for="cf-programme" class="block text-sm font-medium text-brand-800">
            Enquiry Regarding
          </label>
          <select
            id="cf-programme"
            name="programme"
            class="mt-1.5 w-full rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-sm text-ink focus:border-brand-500 focus:bg-surface focus:outline-none"
          >
            <option value="general">General Enquiry</option>
            <option value="ms-ent">MS (ENT) Post Graduate Admission</option>
            <option value="fellowship">Fellowship Programme (Cancer Hospital)</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="cf-message" class="block text-sm font-medium text-brand-800">
            Message <span class="text-accent-600">*</span>
          </label>
          <textarea
            id="cf-message"
            name="message"
            rows="4"
            required
            placeholder="Write your query here..."
            class="mt-1.5 w-full rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-sm text-ink placeholder:text-muted/60 focus:border-brand-500 focus:bg-surface focus:outline-none"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 sm:col-span-2">
          <p class="text-xs text-muted">
            Fields marked with <span class="text-accent-600">*</span> are required.
          </p>
          <button
            type="submit"
            id="cf-submit"
            class="inline-flex items-center justify-center rounded-xl bg-accent-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-accent-700 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send Enquiry
          </button>
        </div>

        <div
          id="cf-status"
          role="status"
          aria-live="polite"
          class="hidden rounded-xl border px-4 py-3 text-sm sm:col-span-2"
        ></div>
      </form>
    </div>

    <!-- Map -->
    <div data-reveal class="overflow-hidden rounded-2xl border border-line shadow-[var(--shadow-card)] lg:col-span-2">
      <iframe title="Map to Sanjeevan PGI, Miraj" src={c.mapEmbed} width="100%" height="320" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('cf-status');
    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;

    if (form && statusEl && submitBtn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const data = new FormData(form);
        // Honeypot check: silently ignore bots
        if (String(data.get('website') || '').trim() !== '') {
          form.reset();
          return;
        }

        const name = String(data.get('name') || '').trim();
        const email = String(data.get('email') || '').trim();
        const message = String(data.get('message') || '').trim();
        const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

        if (!name || !emailValid || !message) {
          statusEl.textContent = 'Please enter your name, a valid email address, and a message.';
          statusEl.className =
            'rounded-xl border border-accent-200 bg-accent-50 px-4 py-3 text-sm text-accent-800 sm:col-span-2';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        window.setTimeout(() => {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Enquiry';
          statusEl.textContent =
            'Thank you! Your enquiry has been recorded (demo form — no backend connected yet). For immediate assistance, please call or email the institute office.';
          statusEl.className =
            'rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-800 sm:col-span-2';
          form.reset();
        }, 400);
      });
    }
  </script>
</BaseLayout>
